# Bounded direct-from-Registry grant discovery. The Registry exposes no
# enumeration getter, so discovery reads its NextGrantId allocator from contract
# instance storage. These caps only apply to the fallback probe used when that
# allocator cannot be read, and keep discovery from ever becoming an unbounded scan.
VITE_MAX_GRANT_ID=100
VITE_GRANT_DISCOVERY_CONCURRENCY=4
VITE_GRANT_READ_TIMEOUT_MS=15000
# Comma-separated Registry grant ids explicitly classified as test records.
VITE_TEST_GRANT_IDS=2
