{
  "name": "starpost-signals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:indexer": "tsc -p indexer/tsconfig.json",
    "typecheck": "tsc -b --pretty false && tsc -p indexer/tsconfig.json --pretty false",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:frontend": "vitest run src",
    "test:indexer": "vitest run indexer",
    "test:e2e": "playwright test",
    "indexer": "tsx indexer/src/main.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "latest",
    "@stellar/stellar-sdk": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "overrides": {
    "axios": "1.19.0",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.11",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
}
