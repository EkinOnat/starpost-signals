{
  "name": "starpost-signals",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:indexer": "tsc -p indexer/tsconfig.json",
    "typecheck": "tsc -b --pretty false && tsc -p indexer/tsconfig.json --pretty false",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:frontend": "vitest run src",
    "test:indexer": "vitest run indexer",
    "test:e2e": "playwright test",
    "indexer": "tsx indexer/src/main.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.5.0",
    "@stellar/stellar-sdk": "16.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "axios": "1.19.0",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
